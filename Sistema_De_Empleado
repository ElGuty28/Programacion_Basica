public class Sistema_De_Empleado {

    public static void main(String[] args) {
    var consola = new Scanner(System.in);
    
    // Nombre del empleado 
    System.out.print("Ingresar nombre del empleado ");
    String nombreEmployee = consola.nextLine();
    
    // Edad del empleado
    System.out.print("Edad del empleado ");
    int edadEmployee = consola.nextInt();
    
    // Salario Empleado 
    System.out.print("Salario del empleado ");
    Double salarioEmployee = consola.nextDouble();
    
    // Jefe de departamento
    System.out.print("Es jefe de departamento (True/False)?: ");
    Boolean esJefeDepartamento = consola.nextBoolean();
    
    // Imprimir los valores del empleado
    System.out.println("\nDatos del empleado ");
